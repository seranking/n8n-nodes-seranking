        "url-tags",
        "analytics-traffic",
        "account-system",
        "sub-account",
        "general-data",
        "marketing-plan",
        "website-audit-project",
        "backlink-checker",
        "search-volume"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "nodes": [
            "dist/nodes/SeRanking/SeRanking.node.js"
        ],
