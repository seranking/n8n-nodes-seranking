    "scripts": {
        "build": "tsc && npm run copy-icons",
        "copy-icons": "node scripts/copy-icons.js",
        "dev": "tsc --watch",
        "prepack": "npm run build",
        "lint": "eslint nodes credentials --ext .ts",
        "format": "prettier --write \"**/*.ts\"",
        "test": "echo \"No tests specified\" && exit 0"
    },
    "devDependencies": {
